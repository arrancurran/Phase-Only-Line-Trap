% Simulation of 1D line trap Based on Yoels paper
clear all; % close all
% Add toolbox to path
addpath( genpath( '/Users/arrancurran/Documents/radboud/software/third party/otslm/' ) )

plt_arr = [ 3, 3 ] ;
radius = 10;          % Inverse length of the line trap (sinc radius)
theta = 0;         % Rotation of pattern (degrees)

sz = [512, 512];      % Size of pattern
o = 200;               % Region of interest size in output
padding = 500;        % Padding for FFT

% incident = [];        % Incident beam (use default in visualize)
incident = ones(sz);  % Incident beam (use uniform illumination)

% Functions used for generating figures
zoom = @(im) im(round(size(im, 1)/2)+(-o:o), round(size(im, 2)/2)+(-o:o));
visualize = @(pattern) zoom(abs(otslm.tools.visualise(pattern, ...
    'method', 'fft', 'padding', padding, 'incident', incident)).^2);
  
%% Roichman and Grier (2006) using 1-D line trap with amplitude encoded in 2d

sinc = otslm.simple.sinc(sz, radius, 'type', '1d', 'angle_deg', theta);

% Generate grid
[~, yy] = otslm.simple.grid(size(sinc), 'angle', theta);

% Generate the pattern
phi = (sinc >= 0)*0.5;
assigned = (abs(yy) < abs(sinc*200));
pattern_sinc = phi .* assigned;

% [pattern_sinc, assigned] = otslm.tools.encode1d(sinc, 'angle_deg', theta, 'scale', 200);
  
% Apply a checkerboard to unassigned regions
grate_line = otslm.simple.linear(sz, 60, 'angle_deg', 45);


grate_spot = otslm.simple.linear(sz, -40, 'angle_deg', 45);


pattern_sinc_grate = pattern_sinc ;
% pattern_sinc_grate(assigned) = mod( ( pattern_sinc(assigned) + pi ) + ( grate_line(assigned) + pi ), 2*pi ) - pi ;
pattern_sinc_grate(assigned) = pattern_sinc(assigned) + grate_line(assigned) ;

pattern = pattern_sinc_grate ;

checker = otslm.simple.checkerboard(sz);

pattern(~assigned) = grate_spot(~assigned);

grate_line = otslm.tools.finalize(grate_line);
grate_spot = otslm.tools.finalize(grate_spot);
pattern = otslm.tools.finalize(pattern);

subplot(plt_arr(1), plt_arr(2) , 1);
imagesc(sinc);
title('Sinc in 1D')

subplot(plt_arr(1), plt_arr(2) , 2);
imagesc(yy);
title('Simple Grid yy')

subplot(plt_arr(1), plt_arr(2) , 3);
imagesc(phi);
title('pattern_sinc = (sinc >= 0) * 0.5')

subplot(plt_arr(1), plt_arr(2) , 4);
imagesc(assigned);
title('assigned bolean')

subplot(plt_arr(1), plt_arr(2) , 5);
imagesc(pattern_sinc);
title('phi .* assigned')

subplot(plt_arr(1), plt_arr(2) , 6);
imagesc(grate_line);
title('grate\_line')

subplot(plt_arr(1), plt_arr(2) , 7);
imagesc(grate_spot);
title('grate\_spot')

subplot(plt_arr(1), plt_arr(2) , 8);
imagesc(pattern_sinc_grate);
title('grate\_spot')

subplot(plt_arr(1), plt_arr(2) , 9);
imagesc(pattern);
title('Final Pattern')



%% Change properties of all figures

for ii = 1:plt_arr(1) * plt_arr(2)
  subplot(plt_arr(1), plt_arr(2) , ii);
  axis('image');
  colormap('gray');
  colorbar
  
  set(gca,'YTickLabel', [], 'XTickLabels', []);
end


figure
imagesc((visualize(pattern)));
axis('image');
colormap('gray');
colorbar

set(gca,'YTickLabel', [], 'XTickLabels', []);